{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rey",
  "scopeName": "source.rey",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings-multiline" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#null" },
    { "include": "#self" },
    { "include": "#storage-modifiers" },
    { "include": "#keywords-control" },
    { "include": "#keywords-declaration" },
    { "include": "#keywords-operator" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#import-statement" },
    { "include": "#enum-pattern" },
    { "include": "#struct-decl" },
    { "include": "#enum-decl" },
    { "include": "#function-decl" },
    { "include": "#lambda" },
    { "include": "#builtin-functions" },
    { "include": "#function-call" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.rey",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.rey",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.rey",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.rey" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.rey" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.braces.rey",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "constant.character.escape.rey",
          "match": "\\\\(?:[nrt\\\\\"'0]|x[0-9a-fA-F]{2})"
        },
        {
          "name": "meta.string.interpolation.rey",
          "begin": "(?<!\\\\)\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.rey" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.rey" }
          },
          "patterns": [
            {
              "include": "#expression-content"
            }
          ]
        }
      ]
    },
    "strings-multiline": {
      "name": "string.quoted.triple.rey",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.rey" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.rey" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.braces.rey",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "meta.string.interpolation.rey",
          "begin": "(?<!\\\\)\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.rey" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.rey" }
          },
          "patterns": [
            {
              "include": "#expression-content"
            }
          ]
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.rey",
      "begin": "'",
      "end": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.rey" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.rey" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.rey",
          "match": "\\\\(?:[nrt\\\\\"'0]|x[0-9a-fA-F]{2})"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.rey",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.rey",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.float.rey",
          "match": "\\b\\d[0-9_]*\\.\\d[0-9_]*(?:[eE][+-]?\\d[0-9_]*)?\\b|\\b\\d[0-9_]*[eE][+-]?\\d[0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.rey",
          "match": "\\b\\d[0-9_]*\\b"
        }
      ]
    },
    "booleans": {
      "name": "constant.language.boolean.rey",
      "match": "\\b(?:true|false)\\b"
    },
    "null": {
      "name": "constant.language.null.rey",
      "match": "\\bnull\\b"
    },
    "self": {
      "name": "variable.language.self.rey",
      "match": "\\bself\\b"
    },
    "storage-modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.visibility.rey",
          "match": "\\b(?:pub|export)\\b"
        }
      ]
    },
    "keywords-control": {
      "name": "keyword.control.rey",
      "match": "\\b(?:if|else|while|for|in|loop|break|continue|return|match)\\b"
    },
    "keywords-declaration": {
      "name": "keyword.declaration.rey",
      "match": "\\b(?:func|var|const|struct|enum|import)\\b"
    },
    "keywords-operator": {
      "name": "keyword.operator.word.rey",
      "match": "\\b(?:instanceof)\\b"
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.rey",
          "match": "\\b(?:int|float|bool|char|string|void|any|uint|byte|double|String|Void|Int)\\b"
        },
        {
          "name": "storage.type.compound.rey",
          "match": "\\b(?:Vec|HashMap|Option|Result|LinkedList|Stack|Queue|ExecResult)\\b"
        },
        {
          "name": "storage.type.custom.rey",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.fat.rey",
          "match": "=>"
        },
        {
          "name": "keyword.operator.arrow.thin.rey",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.rey",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.assignment.compound.rey",
          "match": "(?:\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.increment.rey",
          "match": "(?:\\+\\+|--)"
        },
        {
          "name": "keyword.operator.comparison.rey",
          "match": "(?:==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.rey",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.rey",
          "match": "(?:\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.rey",
          "match": "(?:&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.type.union.rey",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.type.nullable.rey",
          "match": "\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.ellipsis.rey",
          "match": "\\.\\.\\."
        },
        {
          "name": "punctuation.accessor.double-colon.rey",
          "match": "::"
        },
        {
          "name": "punctuation.separator.colon.rey",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.rey",
          "match": ","
        },
        {
          "name": "punctuation.terminator.rey",
          "match": ";"
        },
        {
          "name": "punctuation.accessor.dot.rey",
          "match": "\\."
        }
      ]
    },
    "import-statement": {
      "name": "meta.import.rey",
      "begin": "\\bimport\\b",
      "end": ";",
      "beginCaptures": {
        "0": { "name": "keyword.declaration.import.rey" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.terminator.rey" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        {
          "name": "punctuation.accessor.double-colon.rey",
          "match": "::"
        },
        {
          "name": "punctuation.accessor.dot.rey",
          "match": "\\."
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "name": "entity.name.function.import.rey",
              "match": "[a-zA-Z_][a-zA-Z0-9_]*"
            },
            {
              "name": "punctuation.separator.comma.rey",
              "match": ","
            }
          ]
        },
        {
          "name": "entity.name.module.rey",
          "match": "[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "enum-pattern": {
      "name": "meta.enum-pattern.rey",
      "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(::)\\s*([A-Za-z][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "entity.name.type.enum.rey" },
        "2": { "name": "punctuation.accessor.double-colon.rey" },
        "3": { "name": "variable.other.enummember.rey" }
      }
    },
    "struct-decl": {
      "name": "meta.struct.declaration.rey",
      "begin": "\\b(struct)\\s+([A-Z][a-zA-Z0-9_]*)",
      "end": "(?<=\\})",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.struct.rey" },
        "2": { "name": "entity.name.type.struct.rey" }
      },
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            { "include": "#struct-method" },
            { "include": "#struct-field" }
          ]
        }
      ]
    },
    "struct-field": {
      "name": "meta.struct.field.rey",
      "match": "(?:\\b(pub)\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)\\s*([^,;\\}]+)",
      "captures": {
        "1": { "name": "storage.modifier.visibility.rey" },
        "2": { "name": "variable.other.member.rey" },
        "3": { "name": "punctuation.separator.colon.rey" },
        "4": { "patterns": [{ "include": "#types" }, { "include": "#operators" }] }
      }
    },
    "struct-method": {
      "name": "meta.struct.method.rey",
      "begin": "(?:\\b(pub)\\s+)?\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "end": "(?<=\\})|(?=;)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.visibility.rey" },
        "2": { "name": "keyword.declaration.func.rey" },
        "3": { "name": "entity.name.function.rey" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#function-signature" },
        { "include": "#block-content" }
      ]
    },
    "enum-decl": {
      "name": "meta.enum.declaration.rey",
      "begin": "\\b(enum)\\s+([A-Z][a-zA-Z0-9_]*)",
      "end": "(?<=\\})",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.enum.rey" },
        "2": { "name": "entity.name.type.enum.rey" }
      },
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            {
              "match": "\\b([A-Z][a-zA-Z0-9_]*)(?:\\s*\\(([^)]*)\\))?",
              "captures": {
                "1": { "name": "variable.other.enummember.rey" },
                "2": {
                  "patterns": [
                    { "include": "#types" },
                    { "include": "#operators" },
                    { "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)", "captures": { "1": { "name": "variable.parameter.rey" }, "2": { "name": "punctuation.separator.colon.rey" } } },
                    { "name": "punctuation.separator.comma.rey", "match": "," }
                  ]
                }
              }
            },
            {
              "name": "punctuation.separator.comma.rey",
              "match": ","
            }
          ]
        }
      ]
    },
    "function-decl": {
      "name": "meta.function.declaration.rey",
      "begin": "(?:\\b(export)\\s+)?(?:\\b(pub)\\s+)?\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "end": "(?<=\\})|(?=;)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.visibility.rey" },
        "2": { "name": "storage.modifier.visibility.rey" },
        "3": { "name": "keyword.declaration.func.rey" },
        "4": { "name": "entity.name.function.rey" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#function-signature" },
        { "include": "#block-content" }
      ]
    },
    "function-signature": {
      "patterns": [
        {
          "name": "meta.function.parameters.rey",
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            { "include": "#comments" },
            {
              "name": "punctuation.separator.ellipsis.rey",
              "match": "\\.\\.\\."
            },
            {
              "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
              "captures": {
                "1": { "name": "variable.parameter.rey" },
                "2": { "name": "punctuation.separator.colon.rey" }
              }
            },
            {
              "match": "(=)\\s*([^,)]+)",
              "captures": {
                "1": { "name": "keyword.operator.assignment.rey" },
                "2": { "patterns": [{ "include": "#expression-content" }] }
              }
            },
            { "include": "#types" },
            { "include": "#operators" },
            {
              "name": "punctuation.separator.comma.rey",
              "match": ","
            }
          ]
        },
        {
          "name": "meta.function.return-type.rey",
          "match": "(:)\\s*([^\\{;]+)",
          "captures": {
            "1": { "name": "punctuation.separator.colon.rey" },
            "2": { "patterns": [{ "include": "#types" }, { "include": "#operators" }] }
          }
        }
      ]
    },
    "lambda": {
      "name": "meta.lambda.rey",
      "match": "\\(([^)]*)\\)\\s*(=>)",
      "captures": {
        "1": {
          "patterns": [
            {
              "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?::\\s*([^,)]+))?",
              "captures": {
                "1": { "name": "variable.parameter.rey" },
                "2": { "patterns": [{ "include": "#types" }, { "include": "#operators" }] }
              }
            },
            {
              "name": "punctuation.separator.comma.rey",
              "match": ","
            }
          ]
        },
        "2": { "name": "keyword.operator.arrow.fat.rey" }
      }
    },
    "builtin-functions": {
      "name": "support.function.builtin.rey",
      "match": "\\b(?:println|print|eprintln|eprint|input|assert|typeof|len|push|pop|abs|max|min|pow|sqrt|exp|log|sin|cos|tan|floor|ceil|round|random|wrapAdd|wrapSub|wrapMul|bitAnd|bitOr|bitXor|bitNot|bitShl|bitShr|readFile|writeFile|appendFile|fileExists|deleteFile|copyFile|moveFile|isFile|isDir|mkdir|mkdirAll|removeDir|removeDirAll|listDir|listDirPaths|pathJoin|basename|dirname|extname|args|getEnv|setEnv|unsetEnv|envAll|cwd|chdir|tempDir|exec|execDetailed|which|sleepMs|exit|range|int|char|float|string)\\b(?=\\s*\\()"
    },
    "function-call": {
      "name": "meta.function-call.rey",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.rey" }
      }
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.tuple-index.rey",
          "match": "(?<=\\.)\\b\\d+\\b"
        },
        {
          "name": "variable.other.rey",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "expression-content": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings-multiline" },
        { "include": "#strings" },
        { "include": "#chars" },
        { "include": "#numbers" },
        { "include": "#booleans" },
        { "include": "#null" },
        { "include": "#self" },
        { "include": "#types" },
        { "include": "#builtin-functions" },
        { "include": "#operators" },
        { "include": "#punctuation" },
        { "include": "#identifiers" }
      ]
    },
    "block-content": {
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "source.rey"
            }
          ]
        }
      ]
    }
  }
}